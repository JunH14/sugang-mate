# Keep 1 for a local demo without external model requests.
SUGANG_OFFLINE=1
# Relative paths are resolved from this repository.
# SUGANG_DATA_PATH=data/sample/syllabus_texts.jsonl
# SUGANG_CHROMA_DIR=data/vector_db/chroma
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated alternative models. Empty means no automatic switch.
GEMINI_FALLBACK_MODELS=
ADMIN_PASSWORD=
ANSWER_CACHE_MAX=128
ANSWER_CACHE_TTL_SECONDS=1800
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BASE_SECONDS=0.6
GRADIO_ANALYTICS_ENABLED=False

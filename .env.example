# Keep 1 for a local demo without external model requests.
SUGANG_OFFLINE=1
# Relative paths are resolved from this repository.
# SUGANG_DATA_PATH=data/sample/syllabus_texts.jsonl
# SUGANG_CHROMA_DIR=data/vector_db/chroma
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated alternative models. Empty means no automatic switch.
GEMINI_FALLBACK_MODELS=
ADMIN_PASSWORD=
ANSWER_CACHE_MAX=128
ANSWER_CACHE_TTL_SECONDS=1800
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_BASE_SECONDS=0.6
# Timeout for one Gemini SDK request, in seconds.
GEMINI_TIMEOUT_SECONDS=20
# Public online demo: use python run_public.py with GOOGLE_API_KEY on the server.
# The launcher forces sample data, SUGANG_PUBLIC_DEMO=1 and SUGANG_OFFLINE=0,
# disables admin access, and limits Gemini attempts to 1.
# PORT is supplied by the hosting platform; use 7861 for a local online demo.
# PORT=7861
GRADIO_ANALYTICS_ENABLED=False
